# Copy this file to .env (same folder as server.py) and fill in your own keys.
# .env is git-ignored and the server never serves it to browsers.
PLANTNET_API_KEY=
# Only for Open-Meteo's commercial service; leave empty for non-commercial use.
OPEN_METEO_API_KEY=
# Set to 0.0.0.0 to let a phone on the same Wi-Fi open TERRA at http://<this computer's IP>:8080
TERRA_HOST=
